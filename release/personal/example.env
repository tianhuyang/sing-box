# Personal release settings for Docker image build/push.
# Fill in credentials before running build-and-push.sh.

# Registry target
REGISTRY=registry.hub.docker.com
NAMESPACE=username
IMAGE=sing-box
TAG=fix-http-407-retry

# Optional second tag
PUSH_LATEST=true

# Docker build settings
PLATFORMS=linux/amd64,linux/arm64
DOCKERFILE=Dockerfile
BUILDER_NAME=multiarch

# Binary-based publish settings (used by build-and-push-binary.sh)
BINARY_DOCKERFILE=Dockerfile.binary
BASE_IMAGE=alpine
BINARY_AMD64_PATH=release/personal/bin/sing-box-amd64
BINARY_ARM64_PATH=release/personal/bin/sing-box-arm64

# Credentials
DOCKER_USERNAME=username
DOCKER_PASSWORD=password
